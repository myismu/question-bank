<?xml version="1.0" encoding="UTF-8"?>
<!--
============================================================
项目名称：Question Bank 在线题库系统
项目描述：业务系统仓库 —— 平台能力（用户中心 / 文件服务 / 统一网关 /
        公共库与契约库）来自 cloud-platform 平台仓库

模块结构：
└── service                    - 业务服务模块：
    └── question-bank-service  - 题库服务：题库、题目、试卷管理

依赖说明：
- 父 pom（com.exambaby:cloud-platform）、公共库 common、契约库 api 来自平台仓库
  发布的 GitHub Packages 制品，版本由父 pom 的 platform.libs.version 统一管理
- 用户中心 / 文件服务 / 统一网关由平台统一部署，本仓库不包含其代码
============================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ==================== 父工程（平台仓库发布） ==================== -->
    <!-- relativePath 置空：始终从制品仓库解析父 pom，而不是本地相对路径 -->
    <parent>
        <groupId>com.exambaby</groupId>
        <artifactId>cloud-platform</artifactId>
        <version>1.0.2</version>
        <relativePath/>
    </parent>

    <!-- ==================== 项目坐标 ==================== -->
    <!-- 业务版本独立于平台（避免平台升版时级联改动内部模块引用） -->
    <artifactId>question-bank</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <!-- ==================== 子模块 ==================== -->
    <modules>
        <module>service</module>
    </modules>
</project>
